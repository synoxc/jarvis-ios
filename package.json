{
  "name": "jarvis-ios",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build:ios:dev": "eas build --profile development --platform ios",
    "build:ios:altstore": "eas build --profile development --platform ios --non-interactive",
    "build:ios:preview": "eas build --profile preview --platform ios"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/_backup"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "crypto-js": "^4.2.0",
    "expo": "~57.0.0",
    "expo-audio": "~57.0.5",
    "expo-audio-stream-pcm": "^0.2.0",
    "expo-camera": "57.0.6",
    "expo-constants": "57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "57.0.12",
    "expo-local-authentication": "57.0.3",
    "expo-router": "57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-speech": "57.0.3",
    "expo-speech-recognition": "57.1.1",
    "expo-status-bar": "57.0.1",
    "expo-widgets": "~57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.87.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.0",
    "expo-doctor": "^1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
